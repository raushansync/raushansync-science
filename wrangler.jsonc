{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-ai-tutor",
  "main": "worker.js",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  }
}
